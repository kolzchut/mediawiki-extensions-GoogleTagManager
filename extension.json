{
	"name": "GoogleTagManager",
	"version": "0.7.1",
	"author": [
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://github.com/kolzchut/mediawiki-extensions-GoogleTagManager",
	"descriptionmsg": "googletagmanager-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"GroupPermissions": {
		"bot": {
			"noanalytics": true
		}
	},
	"MessagesDirs": {
		"GoogleTagManager": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\GoogleTagManager\\": "includes/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\GoogleTagManager\\Hooks",
			"services": [
				"MainConfig",
				"HookContainer"
			]
		}
	},
	"Hooks": {
		"BeforePageDisplay": "main",
		"ResourceLoaderGetConfigVars": "main"
	},
	"config": {
		"GoogleTagManagerContainerID": {
			"value": null
		},
		"GoogleTagManagerIgnoreNsIDs": {
			"value": []
		},
		"GoogleTagManagerIgnorePages": {
			"value": []
		},
		"GoogleTagManagerIgnoreSpecials": {
			"value": [
				"Userlogin",
				"Userlogout",
				"Preferences",
				"ChangePassword"
			]
		},
		"GoogleTagManagerMediaWikiEvents": {
			"value": []
		}
	},
	"ResourceModules": {
		"ext.googleTagManager.eventTracking": {
			"scripts": [
				"ext.googleTagManager.eventTracking.js"
			]
		}
	},
	"QUnitTestModule": {
		"localBasePath": "tests/qunit/",
		"remoteExtPath": "GoogleTagManager/tests/qunit/",
		"scripts": [
			"ext.googleTagManager.eventTracking.test.js"
		],
		"dependencies": [
			"ext.googleTagManager.eventTracking"
		]
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "GoogleTagManager/resources"
	},
	"manifest_version": 2
}
